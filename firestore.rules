rules_version = '2';

// Default posture: deny everything from direct client access.
// Almost all reads/writes go through the Cloud Run backend using the
// Admin SDK, which bypasses these rules entirely. These rules only cover
// the narrow set of documents the frontend reads directly for realtime UX
// (own user profile, own notifications) and block everything else,
// including any attempt to write privileged collections directly.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users can read their own profile document directly; all writes
    // (including role changes) must go through the backend.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Users can read their own notifications directly for realtime badges,
    // and mark them read, but cannot create or delete notifications.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_at']);
      allow create, delete: if false;
    }

    // Active categories are readable directly (non-sensitive, avoids an
    // extra API round trip for the nav/category list); all writes go
    // through the backend/admin-only endpoints.
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Everything else (posts, comments, reports, categoryRequests,
    // auditLogs, image metadata) is backend-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
